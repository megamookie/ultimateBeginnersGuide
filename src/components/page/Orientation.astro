---
/**
 * The visible orientation block, generated entirely from machine-readable page metadata.
 *
 * site-product-specification.md v1.0 section 5: "The visible page orientation block should
 * be generated from this metadata rather than maintained separately."
 * page-template.md v1.3: "The site renders the page title and compact orientation block
 * from this metadata. Do not duplicate them manually in the page body."
 *
 * Every value shown here comes from the page's frontmatter, which in turn carries the
 * values stated in the approved source file. No wording originates in this component
 * except the field labels, which are interface chrome.
 */

interface GuideMetadata {
  guide_version: string;
  last_updated: string;
  applies_to: 'Alpha' | 'Omega' | 'Both';
  patch_sensitivity: string;
  estimated_reading_time: string;
  estimated_in_game_time: string;
  approximate_cost: string;
  risk: { level: string; reason: string };
  orientation_note: string | null;
}

interface Props {
  guide: GuideMetadata;
}

const { guide } = Astro.props;

/** Render the ISO date in an unambiguous, locale-neutral form (spec section 9). */
const [year, month, day] = guide.last_updated.split('-');
const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
const lastUpdatedLabel = `${MONTHS[Number(month) - 1]} ${Number(day)}, ${year}`;

const appliesToLabel =
  guide.applies_to === 'Both' ? 'Alpha and Omega accounts' : `${guide.applies_to} accounts`;

const facts: Array<{ label: string; value: string }> = [
  { label: 'Last updated', value: lastUpdatedLabel },
  { label: 'Guide version', value: guide.guide_version },
  { label: 'Applies to', value: appliesToLabel },
  { label: 'Reading time', value: guide.estimated_reading_time },
];

if (guide.estimated_in_game_time !== 'Not applicable') {
  facts.push({ label: 'In-game time', value: guide.estimated_in_game_time });
}
if (guide.approximate_cost !== 'None') {
  facts.push({ label: 'Approximate cost', value: guide.approximate_cost });
}
if (guide.risk.level !== 'Not applicable') {
  facts.push({ label: 'Risk', value: `${guide.risk.level} — ${guide.risk.reason}` });
}
facts.push({ label: 'Patch sensitivity', value: guide.patch_sensitivity });
---

{/*
  Excluded from the search index. The orientation block is repeated metadata on every page;
  indexed, it produces a result whose excerpt is "Alpha and Omega accounts. Reading time
  20–25 minutes…" competing with the actual explanation. site-product-specification.md v1.0
  section 6: "Avoid ranking navigation chrome, repeated metadata, or boilerplate above the
  canonical explanation."
*/}
<aside class="orientation" aria-label="Page orientation" data-pagefind-ignore>
  <dl class="orientation__facts">
    {
      facts.map((fact) => (
        <div class="orientation__fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
  {guide.orientation_note && <p class="orientation__note">{guide.orientation_note}</p>}
</aside>

<style>
  .orientation {
    margin-block: 1rem 1.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    font-size: var(--sl-text-sm);
  }

  .orientation__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0.4rem 1.5rem;
    margin: 0;
  }

  .orientation__fact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .orientation__fact dt {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .orientation__fact dt::after {
    content: ':';
  }

  .orientation__fact dd {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .orientation__note {
    margin: 0.75rem 0 0;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
</style>
