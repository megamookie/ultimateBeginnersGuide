---
/**
 * Starlight `PageTitle` override.
 *
 * Renders the standard page heading, then the metadata-generated orientation block so that
 * no page has to hand-maintain one in its body (page-template.md v1.3).
 */
import Orientation from './Orientation.astro';

/** Starlight's page-title anchor id. Not exported from the package, so it is mirrored here. */
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const guide = (entry.data as { guide?: Parameters<typeof Orientation>[0]['guide'] }).guide;
---

<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
{guide && <Orientation guide={guide} />}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
